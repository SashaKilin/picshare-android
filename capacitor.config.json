{
  "appId": "com.sashakilin.picshare",
  "appName": "PicShare",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}
